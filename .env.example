# RiskLens AI Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./risklens.db

# AI Provider Configuration
# Optional: Provide Google Gemini API Key for LLM-assisted investigation.
# If unset or invalid, the system automatically uses the Deterministic Local Investigation Engine.
GEMINI_API_KEY=

# ML Model Configuration
MODEL_DIR=ml/models/artifacts
FP_COST=250.0
FN_COST=3500.0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
